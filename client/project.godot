config_version=5

[application]
config/name="Hearthvale · Godot Prototype"
run/main_scene="res://bootstrap.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

occlusion_culling/use_occlusion_culling=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.10,0.16,0.14,1)

[editor_plugins]
enabled=PackedStringArray("res://addons/raw_models/plugin.cfg")
